  "cornerRules": {
    "retreat": {
      "name": "有序撤离",
      "text": "战斗奖励发完后，各家将自己仍在冲突区的部队的一半（向下取整）放回驻军，其余照常回供应区。沙虫照常归还。"
    },
    "bidding": {
      "name": "香料悬赏",
      "text": "打出战斗阴谋牌前，所有有单位参战的玩家同时暗握 0 至 2 个香料并揭示。每支付 1 香料，本场 +2 战力。随后照常进行战斗。"
    },
    "lookout": {
      "name": "前哨信号",
      "text": "进入战斗阶段时，从起始玩家起顺时针，每位有单位参战的玩家可召回自己的 1 名间谍，本场 +3 战力。每人限一次。"
    },
    "reserves": {
      "name": "最后援军",
      "text": "打出战斗阴谋牌前，记录此刻所有战力大于 0 的玩家。仅其中战力最低者（含并列）可从驻军增派 1 支部队，各人同时决定。至少须有两人参战。"
    },
    "waterpact": {
      "name": "水之盟约",
      "text": "发完奖励后，若至少两人战力大于 0，其中战力最高者（含并列）可各向一名参战对手赠送自己的 1 水，以获得 1 点任意派系影响力。由起始玩家顺时针各执行至多一次。"
    }
  }
}
